# Copy to docker/market/market.env (git-ignored) and fill in the key.
ELLECTRIC_LLM_API_KEY=
ELLECTRIC_LLM_BASE_URL=https://aispot.swj0227.icu/v1
ELLECTRIC_LLM_MODEL=deepseek-v4.1-flash
# disabled = thinking off (verified: reasoning_tokens=0); low / medium / high = reasoning_effort; default = endpoint default
ELLECTRIC_LLM_THINKING=disabled
ELLECTRIC_LLM_TIMEOUT_SECONDS=45
ELLECTRIC_OLLAMA_URL=http://localhost:11434
ELLECTRIC_EMBEDDING_MODEL=bge-m3
